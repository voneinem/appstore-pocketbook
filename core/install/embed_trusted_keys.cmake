# Turns keys/trusted/*.pub into an include file of quoted base64 strings, one per key, for build_config.cpp.
# Used at configure time and, in script mode, by the tests (cmake -DKEYS_DIR=... -DOUTPUT=... -P this file).
# A missing or malformed key file, no key at all, or more than three keys fails the build (spec FR-006).

function(pbstore_embed_trusted_keys keys_dir output)
    file(GLOB key_files ${keys_dir}/*.pub)
    list(SORT key_files)
    list(LENGTH key_files count)
    if(count EQUAL 0)
        message(FATAL_ERROR "no trusted key in ${keys_dir}: the installer needs at least one")
    endif()
    if(count GREATER 3)
        message(FATAL_ERROR "${count} trusted keys in ${keys_dir}: the installer trusts at most three (current, next, one spare)")
    endif()
    set(items "")
    foreach(key_file IN LISTS key_files)
        file(STRINGS ${key_file} lines)
        list(LENGTH lines line_count)
        if(NOT line_count EQUAL 1)
            message(FATAL_ERROR "${key_file}: a key file holds exactly one line")
        endif()
        string(STRIP "${lines}" key)
        string(LENGTH "${key}" key_length)
        if(NOT key_length EQUAL 44 OR NOT key MATCHES "^[A-Za-z0-9+/]+=$")
            message(FATAL_ERROR "${key_file}: not the base64 of a 32-byte public key")
        endif()
        string(APPEND items "    \"${key}\",\n")
    endforeach()
    file(WRITE ${output} "${items}")
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    pbstore_embed_trusted_keys(${KEYS_DIR} ${OUTPUT})
endif()
