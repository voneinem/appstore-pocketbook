# T069 (story 1, FR-009, FR-010, FR-012): browse the catalog. The demo reader: app-01 installed, app-02 with an update, app-03 and app-05 put
# there by hand, zz-extra and the reader's three default entries put there by hand and not in the catalog; 14 apps in the catalog, so the
# list has 18 rows. The update banner takes one row from each page, so it needs three pages (the search bar takes room too).
# scenario demo
size 1404 1872
wait 400
shot @OUT@/01-start.png

# no catalog yet: the list shows what is on the reader (the catalog line says so) and every control names itself
expect catalogLine No catalog yet
expect refresh Refresh
expect search Search
expect menu Menu
expect_absent updateBanner
expect_absent updateNotice

tap refresh
waitfor catalogLine Catalog last updated
waitfor appRow
shot @OUT@/02-list.png

# the apps of the first page, by name, and the states in words. Feature 004: the app with an update (app-02) is listed first and carries the badge
expect rowName App app-01
expect rowName App app-02
expect rowName App app-03
expect rowState Installed
expect updateNotice 1 update available
expect updateAllButton Update all
shot @OUT@/02c-banner.png
expect_count rowBadge 1
expect rowBadge Update available
expect rowState 1.2.0 → 1.3.0
expect rowState Installed outside the store
expect rowState Not installed
expect pageIndicator 1 / 3
expect_disabled pageUp
expect_enabled pageDown

# (the walk taps rows by their number among the visible items, which is the order of the list only before the first page turn: the details come first)
# the app with an update is the first row (feature 004, FR-013); its detail page carries the same badge and both versions
tap appRow 0
waitfor detailLicense
expect detailBadge Update available
expect detailInstalled 1.2.0
expect detailOffered 1.3.0
shot @OUT@/02b-detail-update.png
tap back
expect pageIndicator 1 / 3

# the detail page of an app: license, author, source, size, minimum firmware, changelog (app-01 is the second row now)
tap appRow 1
waitfor detailLicense
expect detailState Installed
expect detailLicense MIT
expect detailAuthor
expect detailSource
expect detailSize
expect detailMinFirmware 6.
expect detailChangelog
shot @OUT@/04-detail.png

# back: the same page of the list is shown
tap back
expect pageIndicator 1 / 3
expect rowName App app-01

# the last page has the rest, and the app that is on the reader but not in the catalog is labelled so
tap pageDown
expect pageIndicator 2 / 3
expect_enabled pageUp
expect_enabled pageDown
tap pageDown
# (the last page is a partial one: the view stops at the end of the list, so the indicator keeps the number of the page it is on)
expect_enabled pageUp
expect_disabled pageDown
expect rowState Not in the catalog
shot @OUT@/03-page-3.png
tap pageUp
tap pageUp
expect pageIndicator 1 / 3

# a search: the summary says how many apps match, the page is reset to 1, and Back from a detail page keeps the search
tap search
waitfor searchField
tap searchField
type app-07
key Return
waitfor searchSummary 1 of 18 apps
expect_count appRow 1
expect rowName App app-07
shot @OUT@/05-search.png
tap appRow 0
waitfor detailLicense
tap back
expect searchSummary 1 of 18 apps
expect_count appRow 1

# a search with no match
tap searchField
type nothing like this
key Return
waitfor searchSummary No app matches
expect_absent appRow
expect_absent pageIndicator
shot @OUT@/06-no-match.png

# clearing the search brings the whole list back
tap searchClear
waitfor appRow
expect pageIndicator 1 /
quit
