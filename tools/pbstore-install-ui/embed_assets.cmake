# Turns the files of assets/ into a C++ include file with one byte array each. Run at configure time.
function(pbstore_embed_assets assets_dir output)
    set(entries "")
    foreach(name index.html app.js style.css)
        set(path ${assets_dir}/${name})
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${path})
        if(NOT EXISTS ${path})
            file(WRITE ${output} "")
            return()
        endif()
        file(READ ${path} hex HEX)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(MAKE_C_IDENTIFIER ${name} id)
        string(APPEND entries "static const unsigned char kAsset_${id}[] = {${bytes} 0};\n")
        string(APPEND entries "static const unsigned kAssetSize_${id} = sizeof kAsset_${id} - 1;\n")
    endforeach()
    file(WRITE ${output}.tmp "${entries}")
    configure_file(${output}.tmp ${output} COPYONLY)
endfunction()
